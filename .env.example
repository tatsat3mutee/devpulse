# Copy this template to .env for local use. Never put real secrets in this file.

# Required for model-assisted edition drafting.
OPENROUTER_API_KEY=
EDITORIAL_MODEL=google/gemini-2.5-flash

# Optional: increases the GitHub API rate limit during source collection.
GITHUB_TOKEN=

# Optional overrides. Leave commented to use today's date and normal drafting.
# EDITION_DATE=YYYY-MM-DD
# COLLECT_ONLY=true

# Public site URLs, not secrets.
SITE_URL=https://devpulse.tatsatpandey.com
PUBLIC_SITE_URL=https://devpulse.tatsatpandey.com

# Existing EC2 details for setup reference only.
# Deployment reads GitHub Secrets/Variables, not this local file.
EC2_HOST=
EC2_USER=ubuntu
# Prefer setting the private key directly in GitHub's EC2_SSH_KEY secret.
EC2_SSH_KEY=
# Independently verified SSH known_hosts line, not an unverified keyscan result.
EC2_KNOWN_HOSTS=

# For release:probe only: the deployed 40-character Git commit SHA.
RELEASE_SHA=

# GitHub repository variable; changing this locally does not enable Actions.
EDITORIAL_DRAFTS_ENABLED=false