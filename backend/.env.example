# Backend environment variables
# Copy this file to .env and fill in your values

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pulse

# Groq API key — free at https://console.groq.com
# Used for: LLM topic classification, summarization, and chat
GROQ_API_KEY=gsk_...

# Secret for signing JWT auth tokens — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Your email — grants admin access to /api/fetch and admin routes
ADMIN_EMAIL=your@email.com

# ── Cron trigger (optional but recommended) ───────────────────────────────────

# Secret for GitHub Actions cron trigger — generate with: openssl rand -hex 32
# Must also be set as CRON_SECRET in GitHub repo secrets and Render env vars
CRON_SECRET=replace_with_another_random_string

# ── Optional extras ────────────────────────────────────────────────────────────

# Perplexity API key — adds live web search to the Chat page
# Without it, chat falls back to Groq (still works great)
# PERPLEXITY_API_KEY=pplx-...

# Raises GitHub API rate limits for the trending fetcher (5000 req/hr vs 60)
# GITHUB_TOKEN=ghp_...

# Server port (default: 3000)
PORT=3000
