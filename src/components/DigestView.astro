---
import { TOPICS, groupByTopic, topicLabel, type Digest } from "../lib/digest";
import PulseStrip from "./PulseStrip.astro";
import StoryCard from "./StoryCard.astro";

interface Props {
  digest: Digest;
  topic?: (typeof TOPICS)[number]["slug"];
  searchable?: boolean;
  latest?: boolean;
  prev?: string;
  next?: string;
  issue?: number;
}
const { digest, topic, searchable = false, latest = false, prev, next, issue } = Astro.props;
const VISIBLE_PER_TOPIC = 7;
const items = topic ? digest.items.filter((item) => item.topic === topic) : digest.items;
const mustRead = topic ? [] : items.filter((item) => item.mustRead);
const [lead, ...side] = mustRead;
const rest = topic ? items : items.filter((item) => !item.mustRead);
const groups = groupByTopic(rest);
const pageOrder = [...mustRead, ...groups.flatMap((group) => group.items)];
const counts = new Map(groupByTopic(digest.items).map((group) => [group.slug, group.items.length]));
const sourceCount = digest.sources.filter((source) => source.status === "ok").length;
const date = new Date(`${digest.date}T12:00:00Z`);
const dateLabel = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date);
const shortDate = (value: string) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" }).format(new Date(`${value}T12:00:00Z`));
const heading = topic ? topicLabel(topic) : latest ? "Today in AI & systems" : dateLabel;
const strong = items.filter((item) => item.score >= 8).length;
const lede = !topic && digest.lede ? { ...digest.lede, refs: digest.lede.refs.flatMap((ref) => digest.items.filter((item) => item.id === ref)) } : undefined;
const top = items.filter((item) => item.score >= 9).length;
---
<div class="digest shell" data-pagefind-body={searchable ? "" : undefined} data-min="0">
  <header class="edition-head">
    <div class="edition-bar">
      {prev ? <a href={`/edition/${prev}`} rel="prev" class="step">&larr; <span>{shortDate(prev)}</span></a> : <span class="step" aria-hidden="true"></span>}
      <p><time datetime={digest.date}>{dateLabel}</time>{issue ? <span> · No. {issue}</span> : null}</p>
      {next ? <a href={`/edition/${next}`} rel="next" class="step next"><span>{shortDate(next)}</span> &rarr;</a> : latest ? <span class="step next live">Today</span> : <a href="/" class="step next">Today &rarr;</a>}
    </div>
    <div class="head-grid">
      <div>
        <h1>{heading}</h1>
        {lede ? (
          <div class="lede" data-quiet={lede.quiet ? "" : undefined}>
            <p class="lede-label">{lede.quiet ? "A quiet day, in one minute" : latest ? "Today in one minute" : "The day in one minute"}</p>
            <p class="lede-text">{lede.text}</p>
            <ol class="lede-refs" aria-label="Stories in this summary">
              {lede.refs.map((item) => <li><a href={`#${item.id}`}>{item.headline}</a></li>)}
            </ol>
          </div>
        ) : (
          <p class="dek">{topic
            ? `${items.length} ${topicLabel(topic).toLowerCase()} stories from the ${shortDate(digest.date)} edition.`
            : "The stories worth a senior engineer's time today, picked by reading every candidate and keeping only the ones that teach something."}</p>
        )}
      </div>
      {!topic && (
        <dl class="funnel" aria-label="How today's edition was picked">
          {digest.collectedCount && <div><dt>Collected</dt><dd>{digest.collectedCount}</dd></div>}
          <div><dt>Scored</dt><dd>{digest.candidateCount}</dd></div>
          <div><dt>Kept</dt><dd>{digest.items.length}</dd></div>
          <div><dt>Sources</dt><dd>{sourceCount}</dd></div>
        </dl>
      )}
    </div>
    <PulseStrip items={pageOrder} label={topic ? "Pulse" : "Today's pulse"} />
  </header>

  <div class="toolbar">
    <nav class="topics" aria-label="Topics">
      <a href="/" aria-current={!topic ? "page" : undefined}>All <span>{digest.items.length}</span></a>
      {TOPICS.filter((entry) => counts.has(entry.slug)).map((entry) => (
        <a href={`/topic/${entry.slug}`} aria-current={topic === entry.slug ? "page" : undefined} data-desk={entry.desk}>{entry.label} <span>{counts.get(entry.slug)}</span></a>
      ))}
    </nav>
    <div class="signal-filter" role="group" aria-label="Minimum editor score">
      <span class="filter-label" aria-hidden="true">Score</span>
      <button type="button" data-min="0" aria-pressed="true">All <span>{items.length}</span></button>
      <button type="button" data-min="8" aria-pressed="false">Strong <span>{strong}</span></button>
      <button type="button" data-min="9" aria-pressed="false">Essential <span>{top}</span></button>
    </div>
  </div>

  {lead && (
    <section class="must" aria-labelledby="must-read">
      <h2 id="must-read" class="section-label">Must read</h2>
      <div class="must-grid">
        <StoryCard item={lead} variant="lead" />
        {side.length > 0 && <div class="must-side">{side.map((item) => <StoryCard item={item} variant="side" />)}</div>}
      </div>
    </section>
  )}

  {groups.map((group, index) => {
    const [feature, ...others] = group.items;
    const visible = topic ? others : others.slice(0, VISIBLE_PER_TOPIC - 1);
    const hidden = topic ? [] : others.slice(VISIBLE_PER_TOPIC - 1);
    return (
      <section class={`group${index % 2 ? " flip" : ""}`} id={group.slug} aria-labelledby={`h-${group.slug}`} data-desk={group.desk}>
        <header class={`group-head${topic ? " sr-only" : ""}`}>
          <h2 id={`h-${group.slug}`}>{group.label}</h2>
          <span class="count">{group.items.length} {group.items.length === 1 ? "story" : "stories"}</span>
          {!topic && <a href={`/topic/${group.slug}`} class="more-link">Topic page &rarr;</a>}
        </header>
        <StoryCard item={feature} variant="feature" />
        {visible.length > 0 && <div class="grid">{visible.map((item) => <StoryCard item={item} />)}</div>}
        {hidden.length > 0 && (
          <details class="more">
            <summary>{hidden.length} more {hidden.length === 1 ? "story" : "stories"}</summary>
            <div class="grid">{hidden.map((item) => <StoryCard item={item} />)}</div>
          </details>
        )}
      </section>
    );
  })}

  <p class="filter-empty" hidden>No stories at this score today. <button type="button" data-min="0">Show all</button></p>

  <footer class="digest-foot">
    <p>Sources today: {digest.sources.filter((source) => source.count > 0).map((source) => source.label).join(", ")}. Headlines, summaries and diagrams are written by {digest.model.split("/").pop()} from each source's own text; links and images come from the sources themselves. Follow the link before relying on a claim.</p>
    <p>{topic ? <><a href={`/topic/${topic}/rss.xml`}>{topicLabel(topic)} RSS</a> · </> : null}<a href="/rss.xml">RSS</a> · <a href="/json">JSON</a> · <a href={`/digest/${digest.date}.md`}>Markdown</a> · <a href="/pulse">Pulse</a> · <a href="/search">Search</a> · <a href="/archive">Previous days</a></p>
  </footer>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector(".digest");
    if (!root) return;
    const buttons = root.querySelectorAll(".signal-filter button");
    const empty = root.querySelector(".filter-empty");
    const apply = (min) => {
      root.dataset.min = String(min);
      buttons.forEach((button) => button.setAttribute("aria-pressed", String(Number(button.dataset.min) === min)));
      root.querySelectorAll(".story[data-score]").forEach((story) => { story.hidden = Number(story.dataset.score) < min; });
      let shown = 0;
      root.querySelectorAll(".must, .group").forEach((section) => {
        const visible = section.querySelectorAll(".story:not([hidden])").length;
        section.hidden = visible === 0;
        shown += visible;
        const more = section.querySelector("details.more");
        if (more && min > 0 && more.querySelector(".story:not([hidden])")) more.open = true;
        if (more) more.hidden = !more.querySelector(".story:not([hidden])");
      });
      if (empty) empty.hidden = shown > 0;
    };
    // Bring the current topic chip into view inside its own scroller without moving the page.
    const topics = root.querySelector(".topics");
    const current = topics?.querySelector('[aria-current="page"]');
    if (topics && current && topics.scrollWidth > topics.clientWidth) topics.scrollLeft = current.offsetLeft - topics.offsetLeft - (topics.clientWidth - current.clientWidth) / 2;
    root.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-min]");
      if (button) apply(Number(button.dataset.min));
    });
  })();
</script>

<style>
  .digest { padding-top: 22px; }
  .edition-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid rgb(var(--line)); color: rgb(var(--muted)); font: 500 11.5px/1.3 "DM Mono", monospace; letter-spacing: .06em; text-transform: uppercase; }
  .edition-bar p { margin: 0; text-align: center; color: rgb(var(--ink)); }
  .edition-bar p span { color: rgb(var(--muted)); }
  .step { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; }
  a.step:hover { color: rgb(var(--ink)); }
  .step.next { justify-self: end; }
  .step.live { color: rgb(var(--signal)); }
  .step.live::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: rgb(var(--signal)); animation: beat 1.6s ease-in-out infinite; }
  @keyframes beat { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
  .head-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; padding-top: 26px; }
  h1 { margin: 0 0 10px; font: 700 clamp(36px, 5.2vw, 60px)/1.02 "Newsreader", serif; }
  .dek { margin: 0; max-width: 62ch; color: rgb(var(--soft)); font-size: 15.5px; line-height: 1.55; }
  .lede { max-width: 68ch; padding-left: 16px; border-left: 3px solid rgb(var(--ink)); }
  .lede[data-quiet] { border-left-color: rgb(var(--rule-strong)); }
  .lede-label { margin: 0 0 6px; color: rgb(var(--muted)); font: 500 10.5px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .lede-text { margin: 0; color: rgb(var(--ink)); font: 400 18px/1.55 "Newsreader", serif; }
  .lede-refs { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 10px 0 0; padding: 0; list-style: none; counter-reset: ref; }
  .lede-refs li { counter-increment: ref; max-width: 100%; font: 600 12.5px/1.4 "Manrope", sans-serif; }
  .lede-refs li::before { content: counter(ref) " "; color: rgb(var(--muted)); font: 500 11px/1 "DM Mono", monospace; }
  .lede-refs a { color: rgb(var(--soft)); text-decoration: underline; text-decoration-color: rgb(var(--rule-strong)); text-underline-offset: 3px; }
  .lede-refs a:hover { color: rgb(var(--ink)); }
  .funnel { display: grid; grid-auto-flow: column; margin: 0; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); }
  .funnel div { padding: 10px 16px; border-left: 1px solid rgb(var(--line)); }
  .funnel div:first-child { border-left: 0; }
  .funnel dt { color: rgb(var(--muted)); font: 500 10px/1.2 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .funnel dd { margin: 4px 0 0; font: 600 26px/1 "Newsreader", serif; font-variant-numeric: tabular-nums; }

  .toolbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 16px; margin-top: 18px; padding: 10px 0; border-block: 1px solid rgb(var(--ink)); background: rgb(var(--paper) / .96); backdrop-filter: blur(6px); }
  .topics { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .topics::-webkit-scrollbar { display: none; }
  .topics a { display: inline-flex; flex: none; align-items: center; gap: 6px; min-height: 34px; padding: 0 11px; border: 1px solid rgb(var(--line)); border-radius: 17px; color: rgb(var(--soft)); font: 600 12.5px/1 "Manrope", sans-serif; }
  .topics a[data-desk]::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: rgb(var(--desk)); }
  .topics a span { color: rgb(var(--muted)); font: 500 11px/1 "DM Mono", monospace; }
  .topics a:hover { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .topics a[aria-current="page"] { background: rgb(var(--ink)); border-color: rgb(var(--ink)); color: rgb(var(--paper)); }
  .topics a[aria-current="page"] span { color: rgb(var(--paper) / .7); }
  .signal-filter { display: flex; flex: none; align-self: flex-start; margin-left: auto; border: 1px solid rgb(var(--line)); border-radius: 17px; overflow: hidden; }
  .filter-label { display: inline-flex; align-items: center; padding: 0 10px 0 12px; color: rgb(var(--muted)); font: 500 10px/1 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .signal-filter button { min-height: 34px; padding: 0 12px; border: 0; border-left: 1px solid rgb(var(--line)); background: transparent; cursor: pointer; font: 600 12px/1 "Manrope", sans-serif; }

  .signal-filter button span { color: rgb(var(--muted)); font: 500 10.5px/1 "DM Mono", monospace; }
  .signal-filter button[aria-pressed="true"] { background: rgb(var(--ink)); color: rgb(var(--paper)); }
  .signal-filter button[aria-pressed="true"] span { color: rgb(var(--paper) / .75); }

  .section-label { margin: 0 0 14px; color: rgb(var(--muted)); font: 500 11px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .must { padding-top: 30px; }
  .must-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 32px; }
  .must-side { display: grid; align-content: start; gap: 26px; padding-left: 32px; border-left: 1px solid rgb(var(--line)); }

  .group { padding-top: 44px; }
  .group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-bottom: 18px; padding-top: 12px; border-top: 3px solid rgb(var(--desk)); }
  .group-head h2 { margin: 0; font: 700 28px/1.1 "Newsreader", serif; }
  .count { color: rgb(var(--muted)); font: 500 11px/1 "DM Mono", monospace; text-transform: uppercase; letter-spacing: .08em; }
  .more-link { margin-left: auto; color: rgb(var(--soft)); font: 600 12.5px/1 "Manrope", sans-serif; }
  .more-link:hover { color: rgb(var(--ink)); text-decoration: underline; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 28px; margin-top: 6px; }
  .grid > :global(.story) { padding: 18px 0; border-bottom: 1px solid rgb(var(--line)); }
  .more { margin-top: 4px; }
  .more summary { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; margin-top: 10px; padding: 0 14px; border: 1px solid rgb(var(--line)); border-radius: 20px; cursor: pointer; color: rgb(var(--soft)); font: 600 12.5px/1 "Manrope", sans-serif; list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: "+"; font: 500 15px/1 "DM Mono", monospace; color: rgb(var(--desk)); }
  .more[open] summary::before { content: "\2212"; }
  .more summary:hover { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .filter-empty { padding: 40px 0; color: rgb(var(--soft)); }
  .filter-empty button { border: 0; background: none; color: rgb(var(--ink)); cursor: pointer; text-decoration: underline; }

  .digest-foot { margin-top: 48px; padding-top: 18px; border-top: 1px solid rgb(var(--line)); color: rgb(var(--muted)); font-size: 12.5px; line-height: 1.6; }
  .digest-foot a { color: rgb(var(--ink)); text-decoration: underline; text-decoration-color: rgb(var(--rule-strong)); }

  @media (max-width: 980px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .head-grid { grid-template-columns: 1fr; gap: 18px; }
    .funnel { justify-self: start; }
  }
  @media (max-width: 820px) {
    .must-grid { grid-template-columns: 1fr; }
    .must-side { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 820px) {
    .topics { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, #000 88%, transparent); padding-right: 28px; }
    .topics::-webkit-scrollbar { display: none; }
  }
  @media (max-width: 640px) {
    .edition-bar { grid-template-columns: auto 1fr; font-size: 10.5px; letter-spacing: .02em; }
    .edition-bar > span.step:first-child { display: none; }
    .edition-bar p { text-align: left; }
    .step span { display: none; }
    .toolbar { flex-direction: column; align-items: stretch; gap: 8px; }
    .signal-filter { margin-left: 0; align-self: flex-start; }
    .grid { grid-template-columns: 1fr; }
    .funnel { grid-auto-columns: minmax(0, 1fr); justify-self: stretch; }
    .funnel div { padding: 8px 10px; }
    .funnel dd { font-size: 21px; }
    .group-head h2 { font-size: 24px; }
    .more-link { display: none; }
  }
</style>
