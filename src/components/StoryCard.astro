---
import { KINDS, domainOf, topicLabel, type DigestItem } from "../lib/digest";
import { deskOf } from "../lib/visual";
import ArchDiagram from "./ArchDiagram.astro";
import StoryCover from "./StoryCover.astro";

interface Props { item: DigestItem; variant?: "lead" | "side" | "feature" | "card"; showTopic?: boolean }
const { item, variant = "card", showTopic = false } = Astro.props;
const compact = new Intl.NumberFormat("en-US", { notation: "compact" });
const rich = variant === "lead" || variant === "feature";
const hasCover = variant !== "card";
const discussions = item.discussions?.length
  ? item.discussions
  : item.discussionUrl && item.discussionUrl !== item.url ? [{ label: item.sourceLabel, url: item.discussionUrl, comments: item.comments, points: item.points }] : [];
const short = (label: string) => label === "Hacker News" ? "HN" : label;
const facts = [
  domainOf(item.url),
  item.readMinutes && item.readMinutes >= 3 ? `${item.readMinutes} min read` : "",
  item.stars ? `★ ${compact.format(item.stars)}` : "",
  item.source === "papers" && item.points ? `${compact.format(item.points)} upvotes` : "",
  item.source === "models" && item.points ? `${compact.format(item.points)} likes` : "",
].filter(Boolean);
const bars = Math.max(1, Math.min(5, item.score - 5));
---
<article class={`story story--${variant}`} data-score={item.score} data-desk={deskOf(item)}>
  {hasCover && <StoryCover item={item} eager={variant === "lead"} />}
  <div class="story-body">
    <p class="kicker">
      {(showTopic || variant === "lead" || variant === "side") && <span class="topic-tag">{topicLabel(item.topic)}</span>}
      {item.kind && item.kind !== "news" && <span class="badge" data-kind={item.kind}>{KINDS[item.kind]}</span>}
      <span class="signal" role="img" aria-label={`Editor score ${item.score} of 10`} title={`Editor score ${item.score}/10`}>
        {[1, 2, 3, 4, 5].map((n) => <i class={n <= bars ? "on" : undefined}></i>)}
      </span>
    </p>
    <h3 id={item.id}><a href={item.url} rel="noopener noreferrer" target="_blank">{item.headline}</a></h3>
    <p class="why">{item.whyRead}</p>
    {rich && item.brief && (item.brief.length === 3
      ? <ul class="brief labelled">{item.brief.map((point, index) => <li><b>{["What", "How", "Why it matters"][index]}</b>{point}</li>)}</ul>
      : <ul class="brief">{item.brief.map((point) => <li>{point}</li>)}</ul>)}
    {variant === "lead" && item.diagram && <ArchDiagram diagram={item.diagram} id={item.id} />}
    <p class="meta">
      {facts.map((part) => <span>{part}</span>)}
      {discussions.map((d) => (
        <a href={d.url} rel="noopener noreferrer" target="_blank" class="discuss">
          {short(d.label)}{d.points ? <> <b>{compact.format(d.points)}</b> pts</> : null}{d.comments ? <> · <b>{compact.format(d.comments)}</b> {d.comments === 1 ? "comment" : "comments"}</> : null}
        </a>
      ))}
    </p>
  </div>
  {variant === "feature" && item.diagram && <div class="feature-diagram"><ArchDiagram diagram={item.diagram} id={item.id} /></div>}
</article>
<style>
  .story { min-width: 0; }
  .story[hidden] { display: none; }
  .kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 8px; color: rgb(var(--muted)); font: 500 10.5px/1 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .topic-tag { display: inline-flex; align-items: center; gap: 6px; color: rgb(var(--soft)); }
  .topic-tag::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: rgb(var(--desk)); }
  .badge { padding: 3px 6px; border: 1px solid rgb(var(--line)); color: rgb(var(--soft)); font: 500 10px/1 "DM Mono", monospace; letter-spacing: .06em; }
  .badge[data-kind="vulnerability"] { border-color: rgb(var(--signal)); color: rgb(var(--signal)); }
  .badge[data-kind="deep-dive"], .badge[data-kind="postmortem"] { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .signal { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; margin-left: auto; }
  .signal i { width: 3px; background: rgb(var(--rule-strong) / .45); }
  .signal i:nth-child(1) { height: 4px; } .signal i:nth-child(2) { height: 6px; } .signal i:nth-child(3) { height: 8px; } .signal i:nth-child(4) { height: 10px; } .signal i:nth-child(5) { height: 11px; }
  .signal i.on { background: rgb(var(--ink)); }
  h3 { margin: 0; font: 600 19px/1.28 "Newsreader", serif; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  h3 a:visited { color: rgb(var(--soft)); }
  .why { margin: 7px 0 10px; color: rgb(var(--soft)); font-size: 14px; line-height: 1.55; }
  .brief { display: grid; gap: 7px; margin: 0 0 14px; padding: 0; list-style: none; }
  .brief li { position: relative; padding-left: 18px; color: rgb(var(--ink)); font-size: 14px; line-height: 1.5; }
  .brief li::before { content: ""; position: absolute; left: 0; top: .6em; width: 9px; height: 2px; background: rgb(var(--desk)); }
  .brief.labelled li { padding-left: 0; }
  .brief.labelled li::before { display: none; }
  .brief b { display: block; margin-bottom: 1px; color: rgb(var(--muted)); font: 500 10px/1.4 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; color: rgb(var(--muted)); font: 400 11.5px/1.5 "DM Mono", monospace; }
  .discuss { color: rgb(var(--soft)); }
  .discuss b { font-weight: 500; }
  .discuss:hover { text-decoration: underline; }

  .story--lead h3 { font-size: clamp(26px, 3.2vw, 36px); line-height: 1.12; font-weight: 700; }
  .story--lead .why { font-size: 16px; line-height: 1.6; color: rgb(var(--ink)); }
  .story--lead :global(.cover) { margin-bottom: 18px; aspect-ratio: 16 / 9; }
  .story--lead :global(.cover:not(:has(img))) { aspect-ratio: 3 / 1; }
  .story--side { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 16px; align-items: start; }
  .story--side :global(.cover) { aspect-ratio: 4 / 3; }
  .story--side :global(.cover-cap) { display: none; }
  .story--side h3 { font-size: 20px; }
  .story--side .why { font-size: 13.5px; }
  .story--feature { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.3fr); gap: 28px; padding-bottom: 22px; border-bottom: 1px solid rgb(var(--line)); }
  :global(.flip) > .story--feature { grid-template-columns: minmax(0, 1.3fr) minmax(0, .85fr); }
  :global(.flip) > .story--feature > :global(.cover) { order: 2; }
  .story--feature :global(.cover) { aspect-ratio: 16 / 9; align-self: start; }
  .story--feature h3 { font-size: 26px; line-height: 1.16; font-weight: 700; }
  .story--feature .why { font-size: 15px; }
  .feature-diagram { grid-column: 1 / -1; }
  .feature-diagram :global(.diagram) { margin: 0; }

  @media (max-width: 820px) {
    .story--feature, :global(.flip) > .story--feature { grid-template-columns: 1fr; gap: 14px; }
    :global(.flip) > .story--feature > :global(.cover) { order: 0; }
  }
  @media (max-width: 520px) {
    .story--side { grid-template-columns: 96px minmax(0, 1fr); gap: 12px; }
    .story--side h3 { font-size: 18px; }
    .story--feature h3 { font-size: 22px; }
    h3 { font-size: 18px; }
  }
</style>
<style is:global>
  .cover { position: relative; display: block; overflow: hidden; background: rgb(var(--surface)); outline: 1px solid rgb(var(--line)); outline-offset: -1px; }
  .cover img, .cover svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cover img { transition: transform .3s ease; }
  .cover:hover img { transform: scale(1.02); }
  .cover .c-bg { fill: rgb(var(--desk) / .05); }
  .cover .c-fill { fill: rgb(var(--desk)); }
  .cover .c-mute { fill: rgb(var(--rule-strong) / .28); }
  .cover .c-line { fill: none; stroke: rgb(var(--soft) / .45); stroke-width: 1.5; }
  .cover .c-thick { stroke: rgb(var(--desk)); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .cover .c-surface { fill: rgb(var(--surface)); }
  .cover .c-stroke { stroke: rgb(var(--desk)); stroke-width: 2.5; }
  .cover .c-glyph { fill: rgb(var(--desk) / .35); font: 700 200px/1 "Newsreader", serif; }
  .cover-cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; gap: 8px; padding: 5px 8px; background: rgb(var(--surface) / .9); color: rgb(var(--soft)); font: 500 10.5px/1.3 "DM Mono", monospace; letter-spacing: .04em; text-transform: uppercase; }
  .cover-cap span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .diagram { margin: 4px 0 16px; padding: 12px; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); }
  .diagram-scroll { overflow-x: auto; }
  .diagram svg { display: block; max-width: 100%; height: auto; margin: 0 auto; }
  .diagram .d-node { fill: rgb(var(--desk) / .1); stroke: rgb(var(--desk)); stroke-width: 1.5; }
  .diagram .d-label { fill: rgb(var(--ink)); font: 600 12px "Manrope", sans-serif; }
  .diagram .d-edge { fill: none; stroke: rgb(var(--soft)); stroke-width: 1.5; }
  .diagram .d-arrow { fill: rgb(var(--soft)); }
  .diagram .d-edge-label { fill: rgb(var(--muted)); font: 500 10px "DM Mono", monospace; paint-order: stroke; stroke: rgb(var(--surface)); stroke-width: 4px; }
  .diagram figcaption { margin-top: 8px; color: rgb(var(--soft)); font-size: 12.5px; line-height: 1.45; }
  .diagram figcaption span { color: rgb(var(--muted)); }
</style>
