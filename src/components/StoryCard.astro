---
import EvidenceFlow from "./EvidenceFlow.astro";
import ShareBlock from "./ShareBlock.astro";
import StatusBadge from "./StatusBadge.astro";
import type { Story } from "../lib/schema";
import { storyPath, storyShare } from "../lib/share";

interface Props { story: Story; lead?: boolean; index?: number; preview?: boolean; editionDate: string; }
const { story, lead = false, index = 1, preview = true, editionDate } = Astro.props;
const sourceHost = new URL(story.primarySource.url).hostname.replace(/^www\./, "");
const share = storyShare(story, Astro.site!, editionDate);
---
<article id={story.id} tabindex="-1" class:list={["story", { lead }]}>
  <header>
    <div class="story-kicker">
      <span>{String(index).padStart(2, "0")} / {story.section.replace("-", " ")}</span>
      <div><StatusBadge status={story.status} confidence={story.confidence} /></div>
    </div>
    <h2><a href={storyPath(story.id, editionDate)}>{story.title}</a></h2>
    {lead && <p class="source-title">Source headline: “{story.originalTitle}”</p>}
  </header>
  <div class="story-body">
    <div>
      <h3>What changed</h3>
      <p>{story.whatChanged}</p>
    </div>
    <div>
      <h3>Why it matters</h3>
      <p>{story.whyItMatters}</p>
    </div>
  </div>
  <div class="evidence-row">
    <a class="primary-link" href={story.primarySource.url} target="_blank" rel="noopener noreferrer">
      <span>Primary source</span>
      <strong>{story.primarySource.label}</strong>
      <small>{sourceHost} ↗</small>
    </a>
    {story.pushback && (
      <a class="pushback" href={story.pushback.url} target="_blank" rel="noopener noreferrer">
        <span>Strongest pushback</span>
        <p>{story.pushback.summary}</p>
      </a>
    )}
    {!story.pushback && story.discussion && (
      <a class="pushback" href={story.discussion.url} target="_blank" rel="noopener noreferrer">
        <span>Discussion signal</span>
        <p>Counterpoint not reviewed yet. Read the original discussion ↗</p>
      </a>
    )}
  </div>
  {lead && <div class="flow"><EvidenceFlow story={story} /></div>}
  <footer>
    <div class="roles">{story.whoShouldCare.map((role) => <span>{role}</span>)}</div>
    <div class="actions">
      {!preview && <ShareBlock {...share} />}
      <a class="receipts" href={storyPath(story.id, editionDate)}>Inspect receipts →</a>
    </div>
  </footer>
</article>
<style>
  .story { padding: 32px 0; border-bottom: 1px solid rgb(var(--line)); min-width: 0; scroll-margin-top: 16px; }
  .story.lead { padding-top: 0; }
  .story-kicker { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; color: rgb(var(--muted)); font: 500 11px/1.4 "DM Mono", monospace; letter-spacing: 0; text-transform: uppercase; }
  .story-kicker > div { display: flex; flex-wrap: wrap; }
  h2 { margin: 0; max-width: 32ch; font: 600 32px/1.12 "Newsreader", serif; letter-spacing: 0; }
  .lead h2 { max-width: 24ch; font-size: 46px; line-height: 1.06; }
  h2 a:hover { color: rgb(var(--signal)); }
  .source-title { margin: 10px 0 0; color: rgb(var(--muted)); font-size: 12px; }
  .story-body { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; margin-top: 20px; }
  .story-body h3, .evidence-row span { display: block; margin: 0 0 8px; color: rgb(var(--signal)); font: 500 10px/1.3 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .story-body p { margin: 0; color: rgb(var(--soft)); font-size: 16px; line-height: 1.65; }
  .evidence-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 1px; margin-top: 24px; background: rgb(var(--line)); border: 1px solid rgb(var(--line)); }
  .evidence-row > a { display: block; min-width: 0; padding: 16px; background: rgb(var(--surface)); }
  .evidence-row > a:hover { background: rgb(var(--signal-soft)); }
  .primary-link strong { display: block; font: 600 16px/1.3 "Newsreader", serif; }
  .primary-link small { display: block; margin-top: 8px; color: rgb(var(--muted)); font: 400 10px/1.3 "DM Mono", monospace; overflow-wrap: anywhere; }
  .pushback p { margin: 0; color: rgb(var(--soft)); font-size: 13.5px; line-height: 1.55; }
  .flow { margin-top: 22px; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: 18px; margin-top: 18px; }
  .roles { display: flex; flex-wrap: wrap; gap: 6px; }
  .roles span { color: rgb(var(--muted)); font: 500 10px/1 "DM Mono", monospace; letter-spacing: .04em; border: 1px solid rgb(var(--line)); padding: 6px 8px; }
  .actions { display: flex; align-items: center; gap: 14px; }
  .receipts { color: rgb(var(--signal)); font: 600 12px/1 "Manrope", sans-serif; white-space: nowrap; }
  .receipts:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    h2 { font-size: 28px; }
    .lead h2 { font-size: 34px; }
    .story-body, .evidence-row { grid-template-columns: 1fr; }
    .story-body { gap: 18px; }
    footer, .actions { align-items: flex-start; flex-direction: column; }
  }
</style>
