---
import { shareLinks, type ShareInput } from "../lib/share";

interface Props extends ShareInput { variant?: "compact" | "full"; heading?: string; }
const { variant = "compact", heading = "Share this verdict", ...input } = Astro.props;
const links = shareLinks(input);
---
<div class:list={["share", variant]}>
  {variant === "full" && (
    <div class="share-copy">
      <p class="eyebrow">{heading}</p>
      <p class="share-hint">Ready-to-post summary with the verdict and a link to the receipts.</p>
      <pre aria-label="Shareable summary" tabindex="0">{links.post}</pre>
    </div>
  )}
  <div class="share-actions" aria-label={heading}>
    <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`Share “${input.title}” on LinkedIn`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.61 0-1.85 1.25-1.85 2.55v4.91h-4v-11Z" /></svg>
      <span>LinkedIn</span>
    </a>
    <a href={links.x} target="_blank" rel="noopener noreferrer" aria-label={`Share “${input.title}” on X`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.09 14.45Z" /></svg>
      <span>X</span>
    </a>
    <button type="button" data-copy={links.post} aria-label={`Copy summary of “${input.title}”`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8h11v13H8V8Zm2 2v9h7v-9h-7ZM5 3h11v3h-2V5H7v11h1v2H5V3Z" /></svg>
      <span data-copy-label>Copy post</span>
    </button>
    <button type="button" class="native-share" data-native-share data-title={input.title} data-text={links.post} data-url={input.url} hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2.4 1.2l-6.7-3.4a3 3 0 0 0 0-1.6l6.7-3.4A3 3 0 1 0 15 7l-6.7 3.4a3 3 0 1 0 0 3.2L15 17a3 3 0 1 0 3-1Z" /></svg>
      <span>Share</span>
    </button>
  </div>
  <p class="share-status" data-share-status role="status" aria-live="polite" aria-atomic="true"></p>
</div>
<style>
  .share-status { margin: 6px 0 0; max-width: 44ch; color: rgb(var(--soft)); font-size: 12px; line-height: 1.5; }
  .share-actions [hidden] { display: none; }
  .share-actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .share-actions a, .share-actions button { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); color: rgb(var(--soft)); font: 600 12px/1 "Manrope", sans-serif; cursor: pointer; }
  .share-actions a:hover, .share-actions button:hover { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .share-actions svg { width: 13px; height: 13px; fill: currentColor; }
  .compact .share-actions a, .compact .share-actions button { min-height: 44px; padding: 0 8px; }
  .compact .share-actions span { font-size: 10.5px; }
  .full { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-block: 22px; border-block: 1px solid rgb(var(--line)); }
  .share-copy, .share-actions { min-width: 0; }
  .share-hint { margin: 4px 0 12px; color: rgb(var(--muted)); font-size: 12.5px; }
  pre { margin: 0; max-height: 220px; overflow: auto; overflow-wrap: anywhere; padding: 14px 16px; border-left: 3px solid rgb(var(--signal)); background: rgb(var(--paper)); color: rgb(var(--soft)); font: 400 14px/1.6 "Manrope", sans-serif; white-space: pre-wrap; }
</style>
