---
import { ecosystemLabel, type Advisory, type KevEntry } from "../lib/security";

interface Props { kev: KevEntry[]; advisories: Advisory[]; compact?: boolean }
const { kev, advisories, compact = false } = Astro.props;
const shown = { kev: compact ? kev.slice(0, 5) : kev, advisories: compact ? advisories.slice(0, 5) : advisories };
const day = (iso: string) => new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---
<div class={`watch${compact ? " compact" : ""}`} data-desk="security">
  <section aria-label="Actively exploited vulnerabilities">
    <h3>Patch now <span>Exploited in the wild · CISA KEV</span></h3>
    {shown.kev.length ? (
      <ul>
        {shown.kev.map((entry) => (
          <li>
            <a href={entry.url} rel="noopener noreferrer" target="_blank" class="id">{entry.cve}</a>
            <span class="what"><b>{entry.vendor} {entry.product}</b>{entry.name && !compact ? ` · ${entry.name}` : ""}</span>
            <span class="meta">Added {day(entry.dateAdded)}{entry.dueDate && !compact ? ` · fix by ${day(entry.dueDate)}` : ""}{entry.ransomware ? <em>Ransomware</em> : null}</span>
          </li>
        ))}
      </ul>
    ) : <p class="none">No new actively exploited vulnerabilities this week.</p>}
  </section>
  <section aria-label="Critical package advisories">
    <h3>Critical advisories <span>Packages · GitHub Advisory Database</span></h3>
    {shown.advisories.length ? (
      <ul>
        {shown.advisories.map((entry) => (
          <li>
            <a href={entry.url} rel="noopener noreferrer" target="_blank" class="id">{entry.packageName}</a>
            <span class="what">{entry.summary}</span>
            <span class="meta">{ecosystemLabel(entry.ecosystem)} · {day(entry.publishedAt)}{entry.cve && !compact ? ` · ${entry.cve}` : ""}</span>
          </li>
        ))}
      </ul>
    ) : <p class="none">No new critical package advisories this week.</p>}
  </section>
</div>

<style>
  .watch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 10px; padding-bottom: 8px; border-bottom: 2px solid rgb(var(--desk)); font: 700 17px/1.2 "Newsreader", serif; }
  h3 span { color: rgb(var(--muted)); font: 500 10.5px/1.4 "DM Mono", monospace; letter-spacing: .06em; text-transform: uppercase; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { display: grid; gap: 2px; padding: 9px 0; border-bottom: 1px solid rgb(var(--line)); min-width: 0; }
  .id { justify-self: start; max-width: 100%; overflow-wrap: anywhere; color: rgb(var(--ink)); font: 600 13px/1.35 "DM Mono", monospace; text-decoration: underline; text-decoration-color: rgb(var(--desk)); text-underline-offset: 3px; }
  .what { font-size: 14px; line-height: 1.45; overflow-wrap: anywhere; }
  .meta { color: rgb(var(--muted)); font: 400 11.5px/1.5 "DM Mono", monospace; }
  .meta em { margin-left: 8px; padding: 0 5px; border: 1px solid rgb(var(--signal)); color: rgb(var(--signal)); font-style: normal; font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; }
  .none { margin: 6px 0 0; color: rgb(var(--soft)); font-size: 14px; }
  .compact .what { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 760px) { .watch { grid-template-columns: 1fr; gap: 20px; } }
</style>
