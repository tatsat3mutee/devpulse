---
const { status, confidence } = Astro.props;
const labels = {
  developing: "Developing",
  holds: "Holds up",
  contested: "Contested",
  unverified: "Unverified",
};
---
<span class:list={["status", `status-${status}`]}>{labels[status as keyof typeof labels]}</span>
<span class="confidence">{confidence} confidence</span>
<style>
  .status, .confidence { display: inline-flex; align-items: center; min-height: 24px; padding: 4px 8px; border: 1px solid rgb(var(--line)); font: 500 9px/1 "DM Mono", monospace; text-transform: uppercase; white-space: nowrap; }
  .status-holds { color: rgb(var(--verified)); background: rgb(var(--verified-soft)); border-color: rgb(var(--verified) / .38); }
  .status-developing { color: rgb(var(--blue)); }
  .status-contested, .status-unverified { color: rgb(var(--warning)); background: rgb(var(--warning-soft)); border-color: rgb(var(--warning) / .35); }
  .confidence { color: rgb(var(--muted)); border-left: 0; }
</style>
