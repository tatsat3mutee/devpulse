---
import { domainOf, type DigestItem } from "../lib/digest";

interface Props { item: DigestItem; date?: string; discuss?: boolean }
const { item, date = item.publishedAt.slice(0, 10), discuss = true } = Astro.props;
---
<div class="story-actions" data-story-id={item.id} data-url={item.url} data-headline={item.headline} data-date={date} data-topic={item.topic} data-domain={domainOf(item.url)}>
  <button type="button" data-action="save" aria-pressed="false">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="var(--star-fill, none)" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    <span>Save</span>
  </button>
  <button type="button" data-action="note">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    <span>Note</span>
  </button>
  <button type="button" data-action="share">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 13v6h14v-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Share</span>
  </button>
  {discuss && <a href={`/story/${date}--${item.id}/`} class="discuss-link">Notes &amp; discussion</a>}
</div>
<p class="my-note" hidden></p>
<style>
  .story-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin-top: 10px; }
  button, .discuss-link { display: inline-flex; align-items: center; gap: 5px; min-height: 32px; padding: 0 10px 0 8px; border: 1px solid rgb(var(--line)); border-radius: 16px; background: transparent; color: rgb(var(--soft)); cursor: pointer; font: 600 12px/1 "Manrope", sans-serif; }
  button:hover, .discuss-link:hover { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  button[aria-pressed="true"] { --star-fill: currentColor; border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .discuss-link { padding: 0 10px; border-style: dashed; }
  .my-note { margin: 10px 0 0; padding: 8px 10px; border-left: 3px solid rgb(var(--rule-strong)); background: rgb(var(--surface)); color: rgb(var(--ink)); font: 400 13.5px/1.5 "Manrope", sans-serif; white-space: pre-wrap; }
  .my-note::before { content: "Your note"; display: block; margin-bottom: 2px; color: rgb(var(--muted)); font: 500 10px/1.3 "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
</style>
