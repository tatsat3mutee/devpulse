---
import type { Story } from "../lib/schema";
import { STATUS_LABELS } from "../lib/share";

interface Props { story: Story; }
const { story } = Astro.props;
const host = new URL(story.primarySource.url).hostname.replace(/^www\./, "");
const nodes = [
  { label: "Primary source", value: host.length > 22 ? `${host.slice(0, 21)}…` : host, tone: "neutral" },
  { label: "Claim ledger", value: `${story.claims.length} cited quote${story.claims.length === 1 ? "" : "s"}`, tone: "neutral" },
  { label: "Counterweight", value: story.pushback ? "Pushback logged" : "Not reviewed", tone: story.pushback ? "warning" : "neutral" },
  { label: "Verdict", value: `${STATUS_LABELS[story.status]} · ${story.confidence}`, tone: story.status },
];
const description = nodes.map((node) => `${node.label}: ${node.value}`).join(". ");
---
<figure class="evidence-flow">
  <svg class="wide" viewBox="0 0 760 96" role="img" aria-label={`Evidence chain. ${description}`}>
    <defs>
      <marker id={`arrow-${story.id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="arrow-head" /></marker>
    </defs>
    {nodes.map((node, index) => (
      <g transform={`translate(${index * 196} 12)`}>
        <rect width="172" height="72" class:list={["node", `tone-${node.tone}`]} />
        <text x="14" y="28" class="node-label">{node.label}</text>
        <text x="14" y="52" class="node-value">{node.value}</text>
        {index < nodes.length - 1 && <line x1="174" y1="36" x2="194" y2="36" class="edge" marker-end={`url(#arrow-${story.id})`} />}
      </g>
    ))}
  </svg>
  <svg class="tall" viewBox="0 0 320 344" role="img" aria-label={`Evidence chain. ${description}`}>
    {nodes.map((node, index) => (
      <g transform={`translate(0 ${index * 86})`}>
        <rect width="320" height="64" class:list={["node", `tone-${node.tone}`]} />
        <text x="16" y="26" class="node-label">{node.label}</text>
        <text x="16" y="48" class="node-value">{node.value}</text>
        {index < nodes.length - 1 && <line x1="160" y1="66" x2="160" y2="84" class="edge" />}
      </g>
    ))}
  </svg>
</figure>
<style>
  .evidence-flow { margin: 0; }
  svg { display: block; width: 100%; height: auto; }
  .tall { display: none; }
  .node { fill: rgb(var(--surface)); stroke: rgb(var(--line)); stroke-width: 1; }
  .tone-holds { stroke: rgb(var(--verified)); fill: rgb(var(--verified-soft)); }
  .tone-developing { stroke: rgb(var(--blue)); }
  .tone-warning, .tone-contested, .tone-unverified { stroke: rgb(var(--warning)); fill: rgb(var(--warning-soft)); }
  .node-label { fill: rgb(var(--muted)); font: 500 10px "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  .node-value { fill: rgb(var(--ink)); font: 600 14px "Manrope", sans-serif; }
  .edge { stroke: rgb(var(--muted)); stroke-width: 1.5; }
  .arrow-head { fill: rgb(var(--muted)); }
  @media (max-width: 640px) { .wide { display: none; } .tall { display: block; } }
</style>
