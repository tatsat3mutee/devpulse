---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  preview?: boolean;
  feed?: { title: string; path: string };
}

const {
  title = "DevPulse",
  description = "The engineering stories worth your time, every day.",
  canonicalPath = Astro.url.pathname,
  ogType = "website",
  preview = false,
  feed,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f9f8f4" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DevPulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="DevPulse" href="/rss.xml" />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.path} />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600;6..72,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem("devpulse-theme"); } catch {}
      const initialTheme = savedTheme === "dark" || savedTheme === "light" ? savedTheme : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = initialTheme;
      document.querySelector('meta[name="theme-color"]').content = initialTheme === "dark" ? "#10100f" : "#f9f8f4";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="utility-bar shell">
        <a class="utility-link" href="/archive">Archive</a>
        <span class="utility-rule"></span>
        <span>Independent engineering desk</span>
        <nav aria-label="Utility navigation">
          <a href="/search">Search</a>
          <a href="/methodology">How we pick</a>
          <a href="/rss.xml">RSS</a>
          <button id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme" aria-pressed="false">◐</button>
        </nav>
      </div>
      <div class="masthead shell">
        <a href="/" class="brand" aria-label="DevPulse home">
          <img src="/mark.svg" alt="" width="52" height="52" />
          <span>DevPulse</span>
          <strong>Engineering daily</strong>
        </a>
        <p>The engineering stories worth your time, picked from hundreds of candidates every day.</p>
      </div>
      <div class="edition-rule"></div>
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div>
        <strong>DevPulse</strong>
        <p>Hundreds of candidates in, the best few dozen out.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/archive">Archive</a>
        <a href="/methodology">How stories are picked</a>
        <a href="/json">JSON</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
      <p class="footer-note">No ads. No tracking. Every link goes to the original source.</p>
    </footer>
    <script is:inline>
      const themeToggle = document.querySelector("#theme-toggle");
      themeToggle?.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        themeToggle.setAttribute("aria-pressed", String(next === "dark"));
        document.querySelector('meta[name="theme-color"]').content = next === "dark" ? "#10100f" : "#f9f8f4";
        try { localStorage.setItem("devpulse-theme", next); } catch {}
      });
      if ("serviceWorker" in navigator && location.protocol === "https:") navigator.serviceWorker.register("/sw.js").catch(() => {});
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: 249 248 244;
    --surface: 255 255 253;
    --ink: 17 17 16;
    --soft: 65 62 57;
    --muted: 112 107 98;
    --line: 205 201 192;
    --signal: 190 45 35;
    --signal-soft: 250 231 226;
    --verified: 15 116 79;
    --verified-soft: 224 243 233;
    --warning: 148 80 0;
    --warning-soft: 250 235 207;
    --blue: 30 72 145;
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --paper: 16 16 15;
    --surface: 25 24 22;
    --ink: 246 244 238;
    --soft: 195 190 180;
    --muted: 145 139 129;
    --line: 72 69 63;
    --signal: 255 103 87;
    --signal-soft: 75 31 27;
    --verified: 81 211 153;
    --verified-soft: 25 69 51;
    --warning: 245 180 72;
    --warning-soft: 76 52 17;
    --blue: 134 174 238;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { background: rgb(var(--paper)); color: rgb(var(--ink)); font-family: "Manrope", sans-serif; }
  body { margin: 0; min-width: 0; }
  a { color: inherit; text-decoration: none; }
  a, button { touch-action: manipulation; }
  main { overflow-wrap: anywhere; }
  h1, h2, h3, [id] { scroll-margin-top: 16px; }
  button, input { font: inherit; }
  button { color: inherit; }
  :focus-visible { outline: 2px solid rgb(var(--signal)); outline-offset: 3px; }
  .shell { width: min(1160px, calc(100% - 32px)); margin-inline: auto; }
  .skip-link { position: fixed; top: 8px; left: 8px; z-index: 100; transform: translateY(-160%); padding: 8px 12px; background: rgb(var(--ink)); color: rgb(var(--paper)); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { padding-top: 10px; }
  .utility-bar { min-height: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: rgb(var(--muted)); font: 500 11px/1.4 "DM Mono", monospace; letter-spacing: 0; text-transform: uppercase; }
  .utility-bar nav { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .utility-bar a:hover { color: rgb(var(--signal)); }
  .utility-rule { width: 18px; height: 1px; background: rgb(var(--line)); }
  .utility-bar a { display: inline-flex; align-items: center; min-height: 44px; }
  #theme-toggle { width: 44px; height: 44px; border: 1px solid transparent; background: transparent; cursor: pointer; padding: 4px; font-size: 22px; }
  #theme-toggle:hover { color: rgb(var(--signal)); border-color: rgb(var(--line)); }
  .masthead { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 40px; padding: 28px 0 22px; }
  .brand { display: grid; grid-template-columns: auto auto; grid-template-rows: auto auto; align-items: center; column-gap: 14px; row-gap: 6px; font-family: "Newsreader", serif; }
  .brand img { grid-row: 1 / span 2; width: 52px; height: 52px; }
  .brand span { font-size: 56px; font-weight: 700; line-height: .95; letter-spacing: 0; }
  .brand strong { grid-column: 2; color: rgb(var(--signal)); font: 500 10.5px/1 "DM Mono", monospace; letter-spacing: .18em; text-transform: uppercase; }
  .masthead p { justify-self: end; margin: 0; max-width: 300px; text-align: right; color: rgb(var(--soft)); font: 500 14px/1.5 "Manrope", sans-serif; }
  .edition-rule { height: 7px; border-block: 1px solid rgb(var(--ink)); }
  .site-footer { display: grid; grid-template-columns: 1.2fr 1fr .8fr; gap: 32px; border-top: 7px double rgb(var(--ink)); margin-top: 72px; padding: 30px 0 48px; }
  .site-footer strong { font-family: "Newsreader", serif; font-size: 22px; }
  .site-footer p { color: rgb(var(--muted)); font-size: 12px; line-height: 1.6; }
  .site-footer nav { display: grid; gap: 8px; font-size: 12px; }
  .site-footer nav a:hover { color: rgb(var(--signal)); }
  .footer-note { text-align: right; }
  .eyebrow { margin: 0; color: rgb(var(--signal)); font: 500 10.5px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3 { text-wrap: balance; letter-spacing: 0; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
  p { text-wrap: pretty; }
  .mono { font-family: "DM Mono", monospace; }
  @media (max-width: 720px) {
    .utility-bar > span, .utility-bar > .utility-rule { display: none; }
    .utility-bar nav { gap: 12px; }
    .utility-bar nav { flex-wrap: wrap; gap: 8px; }
    .masthead { grid-template-columns: 1fr; gap: 14px; padding: 22px 0 18px; }
    .brand img { width: 44px; height: 44px; }
    .brand span { font-size: 40px; }
    .masthead p { justify-self: start; text-align: left; font-size: 13px; }
    .site-footer { grid-template-columns: 1fr; }
    .footer-note { text-align: left; }
  }
</style>
