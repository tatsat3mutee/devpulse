---
import { getCollection } from "astro:content";
import EvidenceFlow from "../../components/EvidenceFlow.astro";
import ShareBlock from "../../components/ShareBlock.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicEdition, type Story } from "../../lib/schema";
import { storyPath, storyShare } from "../../lib/share";

export async function getStaticPaths() {
  const editions = (await getCollection("editions"))
    .filter((edition) => import.meta.env.DEV || isPublicEdition(edition.data))
    .sort((first, second) => Number(isPublicEdition(second.data)) - Number(isPublicEdition(first.data)) || second.data.date.localeCompare(first.data.date));
  const records = editions.flatMap((edition) => [edition.data.lead, ...edition.data.stories].map((story) => ({
    story, editionDate: edition.data.date, preview: !isPublicEdition(edition.data),
  })));
  const paths = records.map((record) => ({ params: { id: `${record.editionDate}--${record.story.id}` }, props: record }));
  const seen = new Set(paths.map((path) => path.params.id));
  for (const record of records) {
    if (seen.has(record.story.id)) continue;
    seen.add(record.story.id);
    paths.push({ params: { id: record.story.id }, props: record });
  }
  return paths;
}
const { story, editionDate, preview } = Astro.props as { story: Story; editionDate: string; preview: boolean };
const share = storyShare(story, Astro.site!, editionDate);
---
<BaseLayout title={`${story.title} · DevPulse`} description={story.whatChanged} canonicalPath={storyPath(story.id, editionDate)} ogType="article" preview={preview}>
  <article class="receipt shell">
    {preview && <p role="status" class="preview-notice">Pilot preview · Editorial review pending; this story is not published.</p>}
    <a class="back" href={`/edition/${editionDate}`}>← Back to the {editionDate} edition</a>
    <header>
      <p class="eyebrow">Evidence record / {story.section.replace("-", " ")}</p>
      <h1>{story.title}</h1>
      <div class="badges"><StatusBadge status={story.status} confidence={story.confidence} /></div>
      <p class="reason">{story.confidenceReason}</p>
    </header>
    <section class="flow" aria-label="Evidence chain"><EvidenceFlow story={story} /></section>
    <section class="summary">
      <div><h2>What changed</h2><p>{story.whatChanged}</p></div>
      <div><h2>Why it matters</h2><p>{story.whyItMatters}</p></div>
    </section>
    <section class="claims">
      <p class="eyebrow">Claim ledger</p>
      <h2>{preview ? "Claims awaiting editorial review" : "What the evidence supports"}</h2>
      <p class="reason">Source-quote matching checks text presence, not whether the quote supports the claim. That requires editorial review.</p>
      {story.claims.map((claim, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div><h3>{claim.text}</h3><blockquote>“{claim.quote}”</blockquote><a href={claim.sourceUrl} target="_blank" rel="noopener noreferrer">Open cited source ↗</a></div>
        </article>
      ))}
    </section>
    <section class="source-ledger">
      <div>
        <p class="eyebrow">Primary source</p>
        <a href={story.primarySource.url} target="_blank" rel="noopener noreferrer"><strong>{story.primarySource.label}</strong><span>{story.primarySource.type}{story.primarySource.vendorAuthored ? " · vendor authored" : ""}</span></a>
      </div>
      <div>
        <p class="eyebrow">Counterweight</p>
        {story.pushback ? <><p>{story.pushback.summary}</p><a href={story.pushback.url} target="_blank" rel="noopener noreferrer">{story.pushback.label} ↗</a></> : <><p>Counterpoint not reviewed yet.</p>{story.discussion && <a href={story.discussion.url} target="_blank" rel="noopener noreferrer">Read the original discussion ↗</a>}</>}
      </div>
    </section>
    {!preview && <section class="share-section"><ShareBlock {...share} variant="full" /></section>}
    <footer>
      <p>Prepared by {story.provenance.summarizedBy}. {story.provenance.humanReviewed ? "Human reviewed before publication." : "Not yet human reviewed."}</p>
      <p>Evidence fetched <time datetime={story.provenance.fetchedAt}>{new Date(story.provenance.fetchedAt).toLocaleString("en-US", { timeZone: "UTC" })} UTC</time>.</p>
      {story.correction && <p class="correction"><strong>Correction:</strong> {story.correction}</p>}
    </footer>
  </article>
</BaseLayout>
<style>
  .preview-notice { padding: 12px 16px; border-left: 3px solid rgb(var(--warning)); background: rgb(var(--warning-soft)); font-size: 13px; }
  .receipt { max-width: 920px; padding-top: 44px; }
  .back { color: rgb(var(--signal)); font: 500 10.5px/1 "DM Mono", monospace; letter-spacing: .08em; }
  header { padding: 36px 0 30px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 14px 0 22px; max-width: 22ch; font: 600 58px/1.05 "Newsreader", serif; letter-spacing: 0; }
  .flow { padding: 28px 0; border-bottom: 1px solid rgb(var(--line)); }
  .share-section { margin-top: 36px; }
  .badges { display: flex; flex-wrap: wrap; }
  .reason { max-width: 680px; color: rgb(var(--muted)); font-size: 12px; line-height: 1.6; }
  .summary { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding: 34px 0; border-bottom: 1px solid rgb(var(--line)); }
  .summary h2, .claims h2 { font: 600 28px/1.1 "Newsreader", serif; }
  .summary p { color: rgb(var(--soft)); line-height: 1.7; }
  .claims { padding: 36px 0; }
  .claims > h2 { margin: 10px 0 26px; }
  .claims article { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 18px; padding: 22px 0; border-top: 1px solid rgb(var(--line)); }
  .claims article > span { color: rgb(var(--muted)); font: 400 10px/1 "DM Mono", monospace; }
  .claims h3 { margin: 0 0 12px; font-size: 15px; }
  blockquote { margin: 0; border-left: 3px solid rgb(var(--signal)); padding: 12px 16px; background: rgb(var(--surface)); color: rgb(var(--soft)); font: 500 17px/1.55 "Newsreader", serif; }
  .claims a, .source-ledger a { display: inline-block; margin-top: 10px; color: rgb(var(--signal)); font: 500 10px/1.4 "DM Mono", monospace; }
  .source-ledger { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgb(var(--line)); border: 1px solid rgb(var(--line)); }
  .source-ledger > div { background: rgb(var(--surface)); padding: 24px; }
  .source-ledger strong, .source-ledger span { display: block; }
  .source-ledger strong { color: rgb(var(--ink)); font: 600 20px/1.2 "Newsreader", serif; }
  .source-ledger span { margin-top: 6px; color: rgb(var(--muted)); }
  .source-ledger p:not(.eyebrow) { color: rgb(var(--soft)); font-size: 13px; line-height: 1.6; }
  footer { margin-top: 38px; border-top: 1px solid rgb(var(--line)); padding-top: 22px; color: rgb(var(--muted)); font: 400 10px/1.6 "DM Mono", monospace; }
  .correction { color: rgb(var(--warning)); }
  @media (max-width: 650px) { h1 { font-size: 36px; } .summary, .source-ledger { grid-template-columns: 1fr; } }
</style>
