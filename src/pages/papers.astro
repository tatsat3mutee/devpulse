---
import StoryCard from "../components/StoryCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { allDigests } from "../lib/digests";

const digests = await allDigests();
const seen = new Set<string>();
const days = digests.map((digest) => ({
  date: digest.date,
  papers: digest.items.filter((item) => (item.kind === "paper" || item.source === "papers") && !seen.has(item.url) && seen.add(item.url)),
})).filter((day) => day.papers.length).slice(0, 30);
const total = days.reduce((sum, day) => sum + day.papers.length, 0);
const label = (date: string) => new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
---
<BaseLayout title="Papers explained · DevPulse" description="Research papers worth an engineer's time, each with what it is, the method, why it matters and a link to its code.">
  <div class="papers shell">
    <header>
      <p class="eyebrow">Papers explained</p>
      <h1>Research, read for engineers</h1>
      <p class="dek">Every paper DevPulse has kept, newest first. Each one says what it is, the method and why it matters to someone building systems, drawn from the paper's own abstract, with its code and authors where the paper lists them. Read the paper before relying on a result.</p>
      <p class="count">{total} {total === 1 ? "paper" : "papers"}</p>
    </header>
    {days.map((day) => (
      <section aria-labelledby={`d-${day.date}`}>
        <h2 id={`d-${day.date}`}><a href={`/edition/${day.date}`}>{label(day.date)}</a></h2>
        <div class="list">{day.papers.map((item) => <StoryCard item={item} variant="tool" showTopic />)}</div>
      </section>
    ))}
    {days.length === 0 && <p>No papers yet.</p>}
  </div>
</BaseLayout>
<style>
  .papers { max-width: 860px; padding-top: 44px; }
  header { padding-bottom: 20px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 8px 0 10px; font: 700 clamp(34px, 5vw, 52px)/1.05 "Newsreader", serif; }
  .dek { margin: 0; color: rgb(var(--soft)); line-height: 1.6; }
  .count { margin: 12px 0 0; color: rgb(var(--muted)); font: 500 11px/1.4 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; }
  section { padding-top: 30px; }
  h2 { margin: 0 0 6px; color: rgb(var(--muted)); font: 500 11px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  h2 a:hover { color: rgb(var(--ink)); text-decoration: underline; }
  .list > :global(.story) { padding: 18px 0; border-bottom: 1px solid rgb(var(--line)); }
</style>
