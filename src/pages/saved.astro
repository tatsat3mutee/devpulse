---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOPICS } from "../lib/digest";
const apiConfigured = Boolean(import.meta.env.PUBLIC_API_URL);
---
<BaseLayout title="Your library · DevPulse" description="Your saved stories, private notes and followed topics." preview>
  <div class="library shell">
    <header>
      <p class="eyebrow">Your library</p>
      <h1>Saved stories and notes</h1>
      <p class="dek">Save any story with ☆ and add a private note with ✎. Everything is kept in this browser, works offline in the app, and can be exported at any time.{apiConfigured && " Sign in to keep it in sync on every device."}</p>
    </header>

    <section class="account" aria-labelledby="account-h" id="account" data-api={apiConfigured ? "" : undefined}>
      <h2 id="account-h" class="label">Sync</h2>
      {apiConfigured ? (
        <>
          <p class="account-status" id="account-status">Checking your account…</p>
          <div class="signin" id="signin" hidden>
            <a class="provider" data-provider="google" href="#">Continue with Google</a>
            <a class="provider" data-provider="github" href="#">Continue with GitHub</a>
          </div>
          <div class="signed-in" id="signed-in" hidden>
            <button type="button" id="sync-now">Sync now</button>
            <button type="button" id="sign-out" class="quiet">Sign out</button>
            <button type="button" id="delete-account" class="danger">Delete account and synced data</button>
          </div>
          <p class="signin-error" id="signin-error" hidden></p>
        </>
      ) : <p class="account-status">Sync is not switched on for this site yet. Your library is saved in this browser.</p>}
    </section>

    <div class="controls">
      <label class="sr-only" for="filter">Search your library</label>
      <input id="filter" type="search" placeholder="Search headlines and your notes" autocomplete="off" />
      <div class="seg" role="group" aria-label="Show">
        <button type="button" data-show="all" aria-pressed="true">All</button>
        <button type="button" data-show="saved" aria-pressed="false">Saved</button>
        <button type="button" data-show="notes" aria-pressed="false">With notes</button>
      </div>
    </div>
    <p class="count" id="count" aria-live="polite"></p>
    <ol class="items" id="items"></ol>
    <div class="empty" id="empty" hidden>
      <p><strong>Nothing here yet.</strong> Tap <b>Save</b> on any story to keep it, or <b>Note</b> to write down what you want to remember. Start with <a href="/">today's edition</a>.</p>
    </div>

    <section class="prefs" aria-labelledby="prefs-h">
      <h2 id="prefs-h" class="label">For you</h2>
      <p class="hint">Follow topics to get a <b>For you</b> view on every edition. Muted sites never appear in it.</p>
      <div class="topic-list" id="topic-list">
        {TOPICS.map((topic) => <button type="button" data-action="follow" data-topic={topic.slug} data-desk={topic.desk} aria-pressed="false">{topic.label}</button>)}
      </div>
      <form class="mute" id="mute-form">
        <label for="mute-input">Mute a site</label>
        <input id="mute-input" placeholder="example.com" autocomplete="off" inputmode="url" />
        <button type="submit">Mute</button>
      </form>
      <ul class="muted" id="muted"></ul>
    </section>

    <section class="data" aria-labelledby="data-h">
      <h2 id="data-h" class="label">Your data</h2>
      <div class="buttons">
        <button type="button" id="export-md">Export Markdown</button>
        <button type="button" id="export-json">Export JSON</button>
        <label class="import">Import JSON<input type="file" id="import" accept="application/json,.json" /></label>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import * as lib from "../lib/library-client";
  import { TOPICS } from "../lib/digest";

  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const topicLabel = (slug: string) => TOPICS.find((topic) => topic.slug === slug)?.label ?? slug;
  const escape = (value: string) => value.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const day = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
  let show = "all";

  function renderItems() {
    const query = $<HTMLInputElement>("#filter")!.value.trim().toLowerCase();
    const all = lib.library();
    const items = all.filter((entry) => (show === "all" || (show === "saved" ? entry.saved : entry.note.trim()))
      && (!query || `${entry.headline} ${entry.note} ${topicLabel(entry.topic)}`.toLowerCase().includes(query)));
    $("#count")!.textContent = all.length ? `${items.length} of ${all.length} ${all.length === 1 ? "story" : "stories"}` : "";
    $("#empty")!.hidden = all.length > 0;
    $("#items")!.innerHTML = items.map((entry) => `
      <li>
        <p class="meta"><span>${escape(topicLabel(entry.topic))}</span><span>${escape(day(entry.date))}</span>${entry.saved ? "<span>Saved</span>" : ""}</p>
        <h3><a href="${escape(entry.url)}" rel="noopener noreferrer" target="_blank">${escape(entry.headline)}</a></h3>
        <div class="story-actions" data-story-id="${escape(entry.storyId)}" data-url="${escape(entry.url)}" data-headline="${escape(entry.headline)}" data-date="${escape(entry.date)}" data-topic="${escape(entry.topic)}">
          <button type="button" data-action="save" aria-pressed="${entry.saved}"><span>${entry.saved ? "Saved" : "Save"}</span></button>
          <button type="button" data-action="note"><span>${entry.note.trim() ? "Edit note" : "Note"}</span></button>
          <button type="button" data-action="share"><span>Share</span></button>
          <a href="/story/${escape(entry.date)}--${escape(entry.storyId)}/">Notes &amp; discussion</a>
        </div>
        <p class="my-note"${entry.note.trim() ? "" : " hidden"}>${escape(entry.note.trim())}</p>
      </li>`).join("");
  }

  function renderPrefs() {
    const { muted } = lib.prefs();
    $("#muted")!.innerHTML = muted.map((site) => `<li><span>${escape(site)}</span><button type="button" data-unmute="${escape(site)}" aria-label="Unmute ${escape(site)}">×</button></li>`).join("");
  }

  document.querySelectorAll<HTMLButtonElement>("[data-show]").forEach((button) => button.addEventListener("click", () => {
    show = button.dataset.show!;
    document.querySelectorAll("[data-show]").forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
    renderItems();
  }));
  $("#filter")!.addEventListener("input", renderItems);
  $("#mute-form")!.addEventListener("submit", (event) => {
    event.preventDefault();
    const input = $<HTMLInputElement>("#mute-input")!;
    const site = input.value.trim().toLowerCase().replace(/^https?:\/\//, "").replace(/^www\./, "").split(/[/?#]/)[0];
    if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(site)) { input.setCustomValidity("Enter a site like example.com"); input.reportValidity(); return; }
    input.setCustomValidity("");
    const muted = lib.prefs().muted;
    if (!muted.includes(site)) lib.updatePrefs({ muted: [...muted, site].slice(-100) });
    input.value = "";
  });
  $("#muted")!.addEventListener("click", (event) => {
    const site = (event.target as HTMLElement).closest<HTMLElement>("[data-unmute]")?.dataset.unmute;
    if (site) lib.updatePrefs({ muted: lib.prefs().muted.filter((entry) => entry !== site) });
  });

  const download = (name: string, type: string, body: string) => {
    const link = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob([body], { type })), download: name });
    link.click();
    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
  };
  const stamp = () => new Date().toISOString().slice(0, 10);
  $("#export-md")!.addEventListener("click", () => download(`devpulse-library-${stamp()}.md`, "text/markdown", lib.exportMarkdown()));
  $("#export-json")!.addEventListener("click", () => download(`devpulse-library-${stamp()}.json`, "application/json", lib.exportJson()));
  $<HTMLInputElement>("#import")!.addEventListener("change", async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try { alert(`Imported ${lib.importJson(await file.text())} stories.`); }
    catch { alert("That file is not a DevPulse library export."); }
    (event.target as HTMLInputElement).value = "";
  });

  // Account
  async function renderAccount() {
    if (!lib.API_URL) return;
    const account = await lib.currentAccount();
    const status = $("#account-status")!;
    $("#signin")!.hidden = Boolean(account);
    $("#signed-in")!.hidden = !account;
    if (account) {
      const last = lib.syncedAt();
      status.textContent = `Signed in as ${account.name ?? account.email ?? "you"}. ${last ? `Last synced ${new Date(last).toLocaleString()}.` : "Syncing…"}`;
    } else {
      status.textContent = "Sign in to keep your library in sync on your phone and laptop. Without an account it stays in this browser.";
    }
  }
  document.querySelectorAll<HTMLAnchorElement>(".provider").forEach((link) => {
    link.href = lib.signInUrl(link.dataset.provider as "google" | "github", "/saved/");
  });
  const reason = new URLSearchParams(location.search).get("signin");
  if (reason) {
    const error = $("#signin-error");
    if (error) {
      error.hidden = false;
      error.textContent = ({ cancelled: "Sign-in was cancelled.", expired: "That sign-in link expired. Please try again.", unavailable: "That sign-in option is not available yet.", failed: "Sign-in failed. Please try again." } as Record<string, string>)[reason] ?? "Sign-in failed.";
    }
  }
  $("#sync-now")?.addEventListener("click", async () => {
    const result = await lib.sync();
    $("#account-status")!.textContent = result === "synced" ? `Synced ${new Date().toLocaleTimeString()}.` : result === "offline" ? "You are offline; it will sync when you are back." : result === "signed-out" ? "Your session ended. Please sign in again." : "Sync failed. Try again in a minute.";
  });
  $("#sign-out")?.addEventListener("click", async () => { await lib.signOut(); void renderAccount(); });
  $("#delete-account")?.addEventListener("click", async () => {
    if (!confirm("Delete your DevPulse account and everything synced to it? Your library stays in this browser.")) return;
    alert((await lib.deleteAccount()) ? "Your account and synced data were deleted." : "Could not delete the account. Try again.");
    void renderAccount();
  });

  window.addEventListener("devpulse:library", () => { renderItems(); renderPrefs(); void renderAccount(); });
  renderItems();
  renderPrefs();
  void renderAccount();
</script>

<style>
  .library { max-width: 860px; padding-top: 44px; }
  header { padding-bottom: 20px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 8px 0 10px; font: 700 clamp(34px, 5vw, 48px)/1.05 "Newsreader", serif; }
  .dek { margin: 0; color: rgb(var(--soft)); line-height: 1.6; }
  .label { margin: 0 0 10px; color: rgb(var(--muted)); font: 500 11px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  section { padding-top: 28px; }
  .account { padding: 18px; margin-top: 24px; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); }
  .account-status { margin: 0 0 12px; color: rgb(var(--soft)); }
  .signin, .signed-in, .buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .provider, .signed-in button, .buttons button, .import, .mute button { display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border: 1px solid rgb(var(--ink)); background: transparent; color: rgb(var(--ink)); cursor: pointer; font: 600 13.5px/1 "Manrope", sans-serif; }
  .provider { background: rgb(var(--ink)); color: rgb(var(--paper)); }
  .signed-in .quiet { border-color: rgb(var(--line)); }
  .signed-in .danger { border-color: rgb(var(--signal)); color: rgb(var(--signal)); }
  .signin-error { margin: 12px 0 0; color: rgb(var(--signal)); }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .controls input { flex: 1; min-width: 220px; min-height: 44px; padding: 0 12px; border: 1px solid rgb(var(--ink)); background: rgb(var(--surface)); color: rgb(var(--ink)); font-size: 15px; }
  .seg { display: flex; border: 1px solid rgb(var(--line)); }
  .seg button { min-height: 44px; padding: 0 14px; border: 0; background: transparent; color: rgb(var(--soft)); cursor: pointer; font: 600 13px/1 "Manrope", sans-serif; }
  .seg button[aria-pressed="true"] { background: rgb(var(--ink)); color: rgb(var(--paper)); }
  .count { margin: 14px 0 0; color: rgb(var(--muted)); font: 500 11.5px/1.4 "DM Mono", monospace; }
  .items { margin: 0; padding: 0; list-style: none; }
  .items :global(li) { padding: 16px 0; border-bottom: 1px solid rgb(var(--line)); }
  .items :global(.meta) { display: flex; gap: 12px; margin: 0 0 4px; color: rgb(var(--muted)); font: 500 10.5px/1.4 "DM Mono", monospace; letter-spacing: .06em; text-transform: uppercase; }
  .items :global(h3) { margin: 0; font: 600 19px/1.3 "Newsreader", serif; }
  .items :global(h3 a:hover) { text-decoration: underline; }
  .items :global(.story-actions) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .items :global(.story-actions button), .items :global(.story-actions a) { display: inline-flex; align-items: center; min-height: 32px; padding: 0 10px; border: 1px solid rgb(var(--line)); border-radius: 16px; background: transparent; color: rgb(var(--soft)); cursor: pointer; font: 600 12px/1 "Manrope", sans-serif; }
  .items :global(.story-actions [aria-pressed="true"]) { border-color: rgb(var(--ink)); color: rgb(var(--ink)); }
  .items :global(.my-note) { margin: 10px 0 0; padding: 8px 10px; border-left: 3px solid rgb(var(--rule-strong)); background: rgb(var(--surface)); white-space: pre-wrap; font-size: 14px; line-height: 1.5; }
  .empty { padding: 28px 0; color: rgb(var(--soft)); }
  .empty a { color: rgb(var(--ink)); text-decoration: underline; }
  .hint { margin: 0 0 12px; color: rgb(var(--soft)); }
  .topic-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .topic-list button { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 1px solid rgb(var(--line)); border-radius: 18px; background: transparent; color: rgb(var(--soft)); cursor: pointer; font: 600 12.5px/1 "Manrope", sans-serif; }
  .topic-list button::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: rgb(var(--desk)); }
  .topic-list button[aria-pressed="true"] { border-color: rgb(var(--ink)); background: rgb(var(--ink)); color: rgb(var(--paper)); }
  .mute { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; }
  .mute label { color: rgb(var(--soft)); font-weight: 600; font-size: 13.5px; }
  .mute input { min-height: 42px; padding: 0 12px; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); color: rgb(var(--ink)); }
  .muted { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; padding: 0; list-style: none; }
  .muted :global(li) { display: inline-flex; align-items: center; gap: 4px; padding: 2px 4px 2px 10px; border: 1px solid rgb(var(--line)); font: 400 12.5px/1 "DM Mono", monospace; }
  .muted :global(button) { width: 28px; height: 28px; border: 0; background: transparent; cursor: pointer; color: rgb(var(--muted)); font-size: 18px; }
  .import { position: relative; overflow: hidden; }
  .import input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
