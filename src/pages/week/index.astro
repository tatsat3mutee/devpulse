---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allDigests } from "../../lib/digests";
import { groupByWeek, weekRange, weeklySummary } from "../../lib/weekly";

const weeks = groupByWeek(await allDigests()).map(({ week, digests }, index, all) => ({ week, range: weekRange(week), summary: weeklySummary(digests, all[index + 1]?.digests) }));
const day = (date: string) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
---
<BaseLayout title="The weekly · DevPulse" description="Every DevPulse weekly edition: the stories that mattered most each week." feed={{ title: "DevPulse weekly", path: "/week/rss.xml" }}>
  <div class="weeks shell">
    <header><p class="eyebrow">The weekly</p><h1>Every week</h1><p class="dek">The ten stories that mattered most each week, with what moved and what is new on the AI Radar. <a href="/week/rss.xml">Subscribe by RSS</a>.</p></header>
    <ol>
      {weeks.map(({ week, range, summary }) => (
        <li><a href={`/week/${week}`}><span>Week {week.split("-W")[1].replace(/^0/, "")} · {day(range.start)}</span><strong>{summary.top[0]?.headline}</strong><em>{summary.storyCount} stories</em></a></li>
      ))}
    </ol>
  </div>
</BaseLayout>
<style>
  .weeks { max-width: 1040px; padding-top: 44px; }
  header { padding-bottom: 20px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 8px 0 10px; font: 700 44px/1.05 "Newsreader", serif; }
  .dek { margin: 0; color: rgb(var(--soft)); }
  .dek a { color: rgb(var(--ink)); text-decoration: underline; }
  ol { margin: 0; padding: 0; list-style: none; }
  li a { display: grid; grid-template-columns: 190px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid rgb(var(--line)); }
  li a:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  span, em { color: rgb(var(--muted)); font: 400 11px/1.4 "DM Mono", monospace; font-style: normal; text-transform: uppercase; }
  strong { font: 600 19px/1.3 "Newsreader", serif; }
  @media (max-width: 700px) { li a { grid-template-columns: 1fr; gap: 6px; } }
</style>
