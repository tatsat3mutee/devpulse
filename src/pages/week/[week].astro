---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allDigests } from "../../lib/digests";
import { KINDS, domainOf, topicLabel, type Digest } from "../../lib/digest";
import { groupByWeek, weekRange, weeklySummary } from "../../lib/weekly";

export async function getStaticPaths() {
  const weeks = groupByWeek(await allDigests());
  return weeks.map(({ week, digests }, index) => ({
    params: { week },
    props: { week, digests, previous: weeks[index + 1], next: weeks[index - 1]?.week },
  }));
}
const { week, digests, previous, next } = Astro.props as { week: string; digests: Digest[]; previous?: { week: string; digests: Digest[] }; next?: string };
const summary = weeklySummary(digests, previous?.digests);
const { start, end } = weekRange(week);
const day = (date: string, options: Intl.DateTimeFormatOptions = { month: "short", day: "numeric" }) => new Intl.DateTimeFormat("en-US", { ...options, timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
const range = `${day(start)} – ${day(end, { month: "short", day: "numeric", year: "numeric" })}`;
const compact = new Intl.NumberFormat("en-US", { notation: "compact" });
const number = week.split("-W")[1].replace(/^0/, "");
---
<BaseLayout title={`Week ${number} · DevPulse`} description={`The week in AI and systems engineering, ${range}: the ${summary.top.length} stories that mattered most.`} canonicalPath={`/week/${week}`} feed={{ title: "DevPulse weekly", path: "/week/rss.xml" }} image={`/og/${digests[0].date}.png`}>
  <div class="weekly shell">
    <div class="edition-bar">
      {previous ? <a href={`/week/${previous.week}`} rel="prev">&larr; Week {previous.week.split("-W")[1].replace(/^0/, "")}</a> : <span></span>}
      <p>Week {number} · {range}</p>
      {next ? <a href={`/week/${next}`} rel="next">Week {next.split("-W")[1].replace(/^0/, "")} &rarr;</a> : <span></span>}
    </div>
    <header>
      <p class="eyebrow">The weekly</p>
      <h1>The week in AI &amp; systems</h1>
      <p class="dek">The {summary.top.length} stories that mattered most across {summary.editions} {summary.editions === 1 ? "edition" : "editions"}, picked from {summary.storyCount} kept and {summary.candidateCount} scored. Everything here ran in a daily edition first.</p>
    </header>

    <section aria-labelledby="top-h">
      <h2 id="top-h" class="section-label">Top of the week</h2>
      <ol class="top">
        {summary.top.map((item) => (
          <li>
            <p class="meta"><span>{topicLabel(item.topic)}</span>{item.kind && item.kind !== "news" && <span>{KINDS[item.kind]}</span>}<a href={`/edition/${item.date}/#${item.id}`}>{day(item.date, { weekday: "short", month: "short", day: "numeric" })}</a></p>
            <h3><a href={item.url} rel="noopener noreferrer" target="_blank">{item.headline}</a></h3>
            <p class="why">{item.whyRead}</p>
          </li>
        ))}
      </ol>
    </section>

    {summary.deskLeaders.length > 0 && (
      <section aria-labelledby="desks-h">
        <h2 id="desks-h" class="section-label">Also worth your time</h2>
        <div class="desks">
          {summary.deskLeaders.map((group) => (
            <div class="desk" data-desk={group.desk}>
              <h3 class="desk-name">{group.label}</h3>
              <ul>{group.items.map((item) => <li><a href={item.url} rel="noopener noreferrer" target="_blank">{item.headline}</a> <small>{domainOf(item.url)}</small></li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="two">
      {summary.mostDiscussed.length > 0 && (
        <section aria-labelledby="talk-h">
          <h2 id="talk-h" class="section-label">Most discussed</h2>
          <ol class="talk">
            {summary.mostDiscussed.map((item) => (
              <li><a href={item.url} rel="noopener noreferrer" target="_blank">{item.headline}</a>{item.discussionUrl && <a class="count" href={item.discussionUrl} rel="noopener noreferrer" target="_blank">{compact.format(item.comments ?? 0)} comments</a>}</li>
            ))}
          </ol>
        </section>
      )}
      <section aria-labelledby="topics-h">
        <h2 id="topics-h" class="section-label">What moved{previous ? " vs last week" : ""}</h2>
        <table class="topics">
          <thead><tr><th scope="col">Topic</th><th scope="col">Stories</th>{previous && <th scope="col">Change</th>}</tr></thead>
          <tbody>{summary.topics.map((topic) => (
            <tr data-desk={topic.desk}><th scope="row"><a href={`/topic/${topic.slug}`}>{topic.label}</a></th><td>{topic.count}</td>{previous && <td class={topic.delta && topic.delta > 0 ? "up" : topic.delta && topic.delta < 0 ? "down" : ""}>{topic.delta === undefined || topic.delta === 0 ? "–" : topic.delta > 0 ? `▲ ${topic.delta}` : `▼ ${-topic.delta}`}</td>}</tr>
          ))}</tbody>
        </table>
        {summary.newModels.length > 0 && (
          <>
            <h3 class="sub">New on the AI Radar</h3>
            <p class="models">{summary.newModels.map((model) => <a href={`https://huggingface.co/${model.id}`} rel="noopener noreferrer" target="_blank">{model.id}</a>)}</p>
          </>
        )}
      </section>
    </div>
    <p class="foot"><a href="/week/rss.xml">Weekly RSS</a> · <a href="/archive">Every edition</a></p>
  </div>
</BaseLayout>
<style>
  .weekly { max-width: 1040px; padding-top: 22px; }
  .edition-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid rgb(var(--line)); color: rgb(var(--muted)); font: 500 11.5px/1.3 "DM Mono", monospace; letter-spacing: .06em; text-transform: uppercase; }
  .edition-bar p { margin: 0; color: rgb(var(--ink)); text-align: center; }
  .edition-bar a { min-height: 36px; display: inline-flex; align-items: center; }
  .edition-bar a:last-child { justify-self: end; }
  .edition-bar a:hover { color: rgb(var(--ink)); }
  header { padding: 26px 0 22px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 8px 0 10px; font: 700 clamp(34px, 5vw, 56px)/1.03 "Newsreader", serif; }
  .dek { margin: 0; max-width: 64ch; color: rgb(var(--soft)); font-size: 15.5px; line-height: 1.55; }
  section { padding-top: 34px; }
  .section-label { margin: 0 0 12px; color: rgb(var(--muted)); font: 500 11px/1.3 "DM Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .top { margin: 0; padding: 0; list-style: none; counter-reset: top; columns: 2 420px; column-gap: 36px; }
  .top li { counter-increment: top; break-inside: avoid; position: relative; padding: 0 0 18px 40px; }
  .top li::before { content: counter(top); position: absolute; left: 0; top: -4px; font: 700 28px/1 "Newsreader", serif; color: rgb(var(--rule-strong)); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0 0 4px; color: rgb(var(--muted)); font: 500 10.5px/1.4 "DM Mono", monospace; letter-spacing: .06em; text-transform: uppercase; }
  .meta a { color: rgb(var(--soft)); text-decoration: underline; text-decoration-color: rgb(var(--rule-strong)); }
  h3 { margin: 0; font: 600 20px/1.28 "Newsreader", serif; }
  h3 a:hover, .desk a:hover, .talk a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .why { margin: 5px 0 0; color: rgb(var(--soft)); font-size: 14px; line-height: 1.5; }
  .desks { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .desk { padding-top: 10px; border-top: 3px solid rgb(var(--desk)); }
  .desk-name { margin-bottom: 8px; font-size: 17px; }
  .desk ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .desk li { font: 600 15px/1.35 "Newsreader", serif; }
  small { display: block; color: rgb(var(--muted)); font: 400 11px/1.4 "DM Mono", monospace; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .talk { margin: 0; padding-left: 20px; display: grid; gap: 10px; }
  .talk li { font: 600 15.5px/1.35 "Newsreader", serif; }
  .talk .count { display: block; color: rgb(var(--soft)); font: 400 11.5px/1.4 "DM Mono", monospace; }
  .topics { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .topics th, .topics td { padding: 6px 8px 6px 0; border-bottom: 1px solid rgb(var(--line)); text-align: left; }
  .topics thead th { color: rgb(var(--muted)); font: 500 10px/1.2 "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; border-bottom-color: rgb(var(--ink)); }
  .topics tbody th { font-weight: 600; }
  .topics tbody th::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: rgb(var(--desk)); }
  .topics td { font-variant-numeric: tabular-nums; font-family: "DM Mono", monospace; }
  .topics .up { color: rgb(var(--ink)); }
  .topics .down { color: rgb(var(--muted)); }
  .sub { margin: 22px 0 8px; font-size: 17px; }
  .models { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .models a { padding: 4px 8px; border: 1px solid rgb(var(--line)); font: 400 12px/1.3 "DM Mono", monospace; overflow-wrap: anywhere; }
  .models a:hover { border-color: rgb(var(--ink)); }
  .foot { margin-top: 40px; padding-top: 16px; border-top: 1px solid rgb(var(--line)); color: rgb(var(--muted)); font-size: 12.5px; }
  .foot a { color: rgb(var(--ink)); text-decoration: underline; text-decoration-color: rgb(var(--rule-strong)); }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; gap: 0; } .edition-bar { font-size: 10px; } }
</style>
