---
import DigestView from "../components/DigestView.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { allDigests, editionContext } from "../lib/digests";
import { loadSecurityWatch, recentWatch } from "../lib/security";
const digests = await allDigests();
const digest = digests[0];
const context = digest ? editionContext(digests, digest.date) : undefined;
const watch = recentWatch(loadSecurityWatch(), new Date());
---
<BaseLayout title="Diffbrief · Today in AI & systems" description={digest ? `${digest.items.length} AI and systems engineering stories worth reading today, grouped by topic.` : "Daily engineering reading."} image={digest ? `/og/${digest.date}.png` : undefined}>
  {digest ? <DigestView digest={digest} latest prev={context?.prev} issue={context?.issue} previous={digests.find((entry) => entry.date === context?.prev)} watch={watch} /> : <section class="shell"><h1>No digest yet</h1></section>}
</BaseLayout>
