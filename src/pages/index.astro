---
import DigestView from "../components/DigestView.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { latestDigest } from "../lib/digests";
const digest = await latestDigest();
---
<BaseLayout title="DevPulse · Today in engineering" description={digest ? `${digest.items.length} engineering stories worth reading today, grouped by topic.` : "Daily engineering reading."}>
  {digest ? <DigestView digest={digest} /> : <section class="shell"><h1>No digest yet</h1></section>}
</BaseLayout>