---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Offline · DevPulse" description="You are offline." preview>
  <div class="offline shell">
    <p class="eyebrow">Offline</p>
    <h1>You're offline</h1>
    <p class="dek">This page is not saved for offline reading. These are:</p>
    <ul id="saved"><li><a href="/">Today's edition</a></li><li><a href="/pulse">Pulse</a></li></ul>
    <p class="note">DevPulse saves the latest edition when you install it or open it, and every page you read after that.</p>
  </div>
</BaseLayout>
<script is:inline>
  (async () => {
    if (!("caches" in window)) return;
    const pages = await caches.open("devpulse-pages-v4");
    const dates = [...new Set((await pages.keys()).map((request) => new URL(request.url).pathname.match(/^\/edition\/(\d{4}-\d{2}-\d{2})\/?$/)?.[1]).filter(Boolean))].sort().reverse();
    const list = document.querySelector("#saved");
    for (const date of dates) {
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = `/edition/${date}`;
      link.textContent = `Edition of ${new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", timeZone: "UTC" })}`;
      item.append(link);
      list.append(item);
    }
  })().catch(() => {});
</script>
<style>
  .offline { max-width: 720px; padding-top: 56px; }
  h1 { margin: 8px 0 10px; font: 700 44px/1.05 "Newsreader", serif; }
  .dek { color: rgb(var(--soft)); }
  ul { margin: 16px 0; padding: 0; list-style: none; border-top: 1px solid rgb(var(--line)); }
  li { border-bottom: 1px solid rgb(var(--line)); }
  li a { display: block; padding: 14px 0; font: 600 19px/1.3 "Newsreader", serif; }
  li a:hover { text-decoration: underline; }
  .note { color: rgb(var(--muted)); font-size: 13px; }
</style>
