---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isPublicEdition } from "../lib/schema";
import { storyPath } from "../lib/share";
const editions = (await getCollection("editions")).filter((edition) => isPublicEdition(edition.data));
const corrected = editions.flatMap((edition) => [edition.data.lead, ...edition.data.stories].filter((story) => story.correction).map((story) => ({ story, date: edition.data.date })));
---
<BaseLayout title="Corrections · DevPulse Daily Verdict" description="The public DevPulse corrections log.">
  <div class="corrections shell">
    <header><p class="eyebrow">Public record</p><h1>Corrections</h1><p>Errors are corrected in place, dated here, and preserved in version history. Quiet edits are not corrections.</p></header>
    {corrected.length === 0 ? <section><strong>No published corrections.</strong><p>That is not a claim of perfection. Each edition links to the evidence needed to challenge it.</p></section> : <ol>{corrected.map(({ story, date }) => <li><time datetime={date}>{date}</time><a href={storyPath(story.id, date)}>{story.title}</a><p>{story.correction}</p></li>)}</ol>}
  </div>
</BaseLayout>
<style>
  .corrections { max-width: 860px; padding-top: 52px; }
  header { border-bottom: 2px solid rgb(var(--ink)); padding-bottom: 30px; }
  h1 { margin: 10px 0; font: 700 48px/1.05 "Newsreader", serif; }
  @media (max-width: 650px) { h1 { font-size: 38px; } }
  header p:last-child, section p { color: rgb(var(--soft)); line-height: 1.65; }
  section { margin-top: 30px; padding: 24px; border: 1px solid rgb(var(--line)); background: rgb(var(--surface)); }
  section strong { font: 600 24px/1 "Newsreader", serif; }
</style>
