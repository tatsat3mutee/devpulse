---
import DigestView from "../../components/DigestView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { latestDigest } from "../../lib/digests";
import { TOPICS, topicLabel, type Digest, type TopicSlug } from "../../lib/digest";

export async function getStaticPaths() {
  const digest = await latestDigest();
  return digest ? TOPICS.filter((topic) => digest.items.some((item) => item.topic === topic.slug)).map((topic) => ({ params: { topic: topic.slug }, props: { digest, topic: topic.slug } })) : [];
}
const { digest, topic } = Astro.props as { digest: Digest; topic: TopicSlug };
---
<BaseLayout image={`/og/${digest.date}.png`} title={`${topicLabel(topic)} · DevPulse`} description={`Today's ${topicLabel(topic).toLowerCase()} stories for engineers.`} feed={{ title: `DevPulse · ${topicLabel(topic)}`, path: `/topic/${topic}/rss.xml` }}>
  <DigestView digest={digest} topic={topic} />
</BaseLayout>
