---
import DigestView from "../../components/DigestView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allDigests, editionContext } from "../../lib/digests";
import type { Digest } from "../../lib/digest";

export async function getStaticPaths() {
  const digests = await allDigests();
  return digests.map((digest) => {
    const context = editionContext(digests, digest.date);
    return { params: { date: digest.date }, props: { digest, ...context, previous: digests.find((entry) => entry.date === context.prev) } };
  });
}
const { digest, prev, next, issue, previous } = Astro.props as { digest: Digest; prev?: string; next?: string; issue: number; previous?: Digest };
---
<BaseLayout title={`${digest.date} · DevPulse`} description={`${digest.items.length} engineering stories from ${digest.date}.`} canonicalPath={`/edition/${digest.date}`} image={`/og/${digest.date}.png`}>
  <DigestView digest={digest} prev={prev} next={next} issue={issue} previous={previous} />
</BaseLayout>
