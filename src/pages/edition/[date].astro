---
import DigestView from "../../components/DigestView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allDigests } from "../../lib/digests";
import type { Digest } from "../../lib/digest";

export async function getStaticPaths() {
  return (await allDigests()).map((digest) => ({ params: { date: digest.date }, props: { digest } }));
}
const { digest } = Astro.props as { digest: Digest };
---
<BaseLayout title={`${digest.date} · DevPulse`} description={`${digest.items.length} engineering stories from ${digest.date}.`} canonicalPath={`/edition/${digest.date}`}>
  <DigestView digest={digest} searchable />
</BaseLayout>
