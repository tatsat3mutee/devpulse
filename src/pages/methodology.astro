---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOGS } from "../../scripts/lib/collect";
const steps = [
  ["Collect", "Every morning we pull about 250 fresh candidates: the Hacker News front page and best list, Lobsters, fast-rising new GitHub repositories, Hugging Face daily papers, and engineering blogs from teams and writers worth following."],
  ["Read", "For each candidate we fetch the linked page and keep a short excerpt of its own text."],
  ["Judge", "A language model scores every candidate from 1 to 10 on one question: would a senior engineer want to read this? Depth, novelty and hard-won production lessons score high. Funding news, politics, drama, marketing and generic AI hype score low."],
  ["Write", "The model writes a plain headline and one reason to read it, using only the title and excerpt. It never chooses or edits links, and never invents numbers or results."],
  ["Balance", "The top 50 are published, with limits per topic and on papers so no single subject crowds out the rest. Near-duplicate stories from different sources are merged."],
];
---
<BaseLayout title="How we pick · DevPulse" description="How DevPulse picks the daily engineering stories.">
  <article class="policy shell">
    <header><p class="eyebrow">How we pick</p><h1>Hundreds of sources in.<br />The best few dozen out.</h1></header>
    <ol>{steps.map(([name, text], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h2>{name}</h2><p>{text}</p></div></li>)}</ol>
    <section class="blogs">
      <h2>Blogs we read</h2>
      <p>{BLOGS.map(([, label]) => label).join(" · ")}</p>
      <p class="note">Summaries are machine-written from each source's own text. Treat them as a reason to click, and follow the link before relying on a claim.</p>
    </section>
  </article>
</BaseLayout>
<style>
  .policy { max-width: 860px; padding-top: 44px; }
  h1 { margin: 10px 0 24px; font: 700 52px/1.05 "Newsreader", serif; }
  ol { margin: 0; padding: 0; list-style: none; border-top: 2px solid rgb(var(--ink)); }
  li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; padding: 20px 0; border-bottom: 1px solid rgb(var(--line)); }
  li > span { color: rgb(var(--signal)); font: 500 11px/1.8 "DM Mono", monospace; }
  li h2 { margin: 0; font: 600 24px/1.1 "Newsreader", serif; }
  li p { margin: 6px 0 0; color: rgb(var(--soft)); line-height: 1.65; }
  .blogs { margin-top: 36px; }
  .blogs h2 { font: 600 24px/1.1 "Newsreader", serif; }
  .blogs p { color: rgb(var(--soft)); line-height: 1.7; }
  .note { color: rgb(var(--muted)); font-size: 13px; }
  @media (max-width: 650px) { h1 { font-size: 36px; } }
</style>
