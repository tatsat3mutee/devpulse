---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allDigests } from "../lib/digests";
const digests = await allDigests();
const format = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title="Archive · DevPulse" description="Every past DevPulse daily edition.">
  <div class="archive shell">
    <header><p class="eyebrow">Archive</p><h1>Previous days</h1></header>
    <ol>
      {digests.map((digest) => (
        <li>
          <a href={`/edition/${digest.date}`}>
            <time datetime={digest.date}>{format.format(new Date(`${digest.date}T12:00:00Z`))}</time>
            <strong>{(digest.items.find((item) => item.mustRead) ?? digest.items[0]).headline}</strong>
            <span>+{digest.items.length - 1} stories</span>
          </a>
        </li>
      ))}
    </ol>
    {digests.length === 0 && <p>No editions yet.</p>}
  </div>
</BaseLayout>
<style>
  .archive { max-width: 1040px; padding-top: 44px; }
  header { padding-bottom: 20px; border-bottom: 2px solid rgb(var(--ink)); }
  h1 { margin: 8px 0 0; font: 700 44px/1.05 "Newsreader", serif; }
  ol { margin: 0; padding: 0; list-style: none; }
  li { border-bottom: 1px solid rgb(var(--line)); }
  li a { display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: 24px; align-items: baseline; padding: 18px 0; }
  li a:hover strong { text-decoration: underline; text-underline-offset: 3px; }
  time, li span { color: rgb(var(--muted)); font: 400 11px/1.4 "DM Mono", monospace; text-transform: uppercase; }
  li strong { font: 600 19px/1.3 "Newsreader", serif; }
  @media (max-width: 700px) { h1 { font-size: 34px; } li a { grid-template-columns: 1fr; gap: 6px; } }
</style>
